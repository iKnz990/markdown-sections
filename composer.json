{
    "name": "nocturnal/markdown-sections",
    "description": "Safe Markdown edits for agents with source-preserving PHP primitive patches.",
    "type": "library",
    "homepage": "https://github.com/iKnz990/markdown-sections",
    "keywords": [
        "commonmark",
        "cms",
        "agent-safe",
        "llm",
        "markdown",
        "markdown-editor",
        "markdown-parser",
        "markdown-primitives",
        "source-preserving"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Nocturnal Marketing"
        }
    ],
    "support": {
        "issues": "https://github.com/iKnz990/markdown-sections/issues",
        "source": "https://github.com/iKnz990/markdown-sections"
    },
    "require": {
        "php": ">=8.2",
        "league/commonmark": "^2.8"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Nocturnal\\MarkdownSections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nocturnal\\MarkdownSections\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check-composer": "composer validate --strict",
        "check-syntax": "@php tools/check-syntax.php",
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check-examples": "php tools/run-examples.php",
        "check-lines": "php tools/check-file-lines.php src tests examples tools",
        "check-archive": "@php tools/check-archive.php",
        "qa": [
            "@check-composer",
            "@check-syntax",
            "@test",
            "@analyse",
            "@check-examples",
            "@check-lines"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/composer.lock",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/.phpstan.cache",
            "/coverage",
            "/build",
            "/.idea",
            "/.vscode",
            "*.log",
            "*.tmp",
            ".DS_Store",
            "Thumbs.db"
        ]
    }
}
