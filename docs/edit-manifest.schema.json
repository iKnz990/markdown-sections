{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/iKnz990/markdown-sections/blob/main/docs/edit-manifest.schema.json",
  "title": "Nocturnal Markdown Sections Edit Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "documentChecksum",
    "sections"
  ],
  "properties": {
    "documentChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 checksum for the full Markdown document that produced this manifest."
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "type",
        "attributes",
        "content",
        "source",
        "checksum",
        "valid",
        "issues"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "attributes": {
          "description": "Attribute map. PHP json_encode emits [] for an empty map; nonempty maps are objects.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": {"type": "string"}
            },
            {
              "type": "array",
              "maxItems": 0
            }
          ]
        },
        "content": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/sourceSpan"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 checksum for the raw section source."
        },
        "valid": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startLine",
        "endLine",
        "startOffset",
        "endOffset"
      ],
      "properties": {
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "line"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
